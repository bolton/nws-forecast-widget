{
	"name": "nws-forecast-widget",
	"version": "0.1.1",
	"description": "A dependency-free web component that shows the National Weather Service forecast for any US latitude and longitude. No API key required.",
	"type": "module",
	"main": "./src/index.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./client": {
			"types": "./types/client.d.ts",
			"default": "./src/client.js"
		}
	},
	"files": [
		"src",
		"types"
	],
	"sideEffects": [
		"./src/index.js"
	],
	"scripts": {
		"test": "node --test",
		"serve": "npx --yes http-server@14.1.1 -c-1 -p 8411 .",
		"build:wp": "node scripts/build-wp.js"
	},
	"keywords": [
		"weather",
		"forecast",
		"nws",
		"noaa",
		"national-weather-service",
		"weather-widget",
		"web-component",
		"custom-element",
		"vanilla-js"
	],
	"author": "Rob Bolton (https://www.beexploring.com/)",
	"homepage": "https://github.com/bolton/nws-forecast-widget#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bolton/nws-forecast-widget.git"
	},
	"bugs": {
		"url": "https://github.com/bolton/nws-forecast-widget/issues"
	},
	"license": "MIT",
	"devDependencies": {
		"esbuild": "0.28.2"
	}
}
